#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <150>;
    flavor = "balanced";
};

&mt {
    tapping-term-ms = <150>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        f2 {
            bindings = <&kp F2>;
            key-positions = <16 15>;
        };

        lclk {
            bindings = <&mkp LCLK>;
            key-positions = <19 20>;
        };

        rckl {
            bindings = <&mkp RCLK>;
            key-positions = <20 21>;
        };

        rayer {
            bindings = <&lt 4 INTERNATIONAL_4>;
            key-positions = <19 20 21>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB        &kp Q         &kp W         &kp E        &kp R      &kp T       &kp Y        &kp U         &kp I  &kp O           &kp P                 &kp MINUS
&kp BACKSPACE  &kp A         &kp S         &kp D        &kp F      &kp G       &kp H        &kp J         &kp K  &kp L           &kp SEMI              &kp ENTER
&kp LSHFT      &kp Z         &kp X         &kp C        &kp V      &kp B       &mo 5        &lt 4 DELETE  &kp N  &kp M           &kp COMMA             &kp DOT          &mt RIGHT_SHIFT UP_ARROW  &mt RSHFT QUESTION
&mo 2          &kp LEFT_GUI  &kp LEFT_ALT  &lt 4 LG(V)  &mkp LCLK  &lt 4 INT5  &lt 3 SPACE  &lt 3 SPACE   &mo 2  &kp LEFT_ARROW  &mt RCTRL DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&kp ESCAPE       &kp F10                  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans  &kp PG_UP  &trans     &kp UP_ARROW    &trans     &trans    &kp LS(MINUS)
&trans           &kp LS(INTERNATIONAL_1)  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans  &kp PG_DN  &kp LEFT   &kp DOWN_ARROW  &kp RIGHT  &kp APOS  &kp LC(V)
&kp KP_MULTIPLY  &kp KP_SLASH             &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans  &trans     &trans     &trans          &trans     &trans    &trans         &trans  &trans
&trans           &trans                   &kp KP_NUMBER_0  &none            &kp KP_NUMBER_0  &trans  &trans     &kp LC(C)  &trans          &trans     &trans    &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &kp LS(N1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)  &kp LS(NUMBER_6)  &kp LS(N7)  &kp LS(N8)        &kp LS(N9)         &kp LS(N0)     &kp LS(EQUAL)
&trans  &trans      &trans            &trans            &trans            &trans      &trans            &trans      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp NUHS       &trans
&trans  &trans      &trans            &trans            &trans            &trans      &trans            &trans      &trans            &trans             &kt BACKSLASH  &trans         &kp QUESTION  &trans
&trans  &trans      &trans            &trans            &trans            &trans      &trans            &trans      &trans            &trans             &trans         &trans
            >;
        };

        layer_5 {
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans          &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans          &trans        &trans        &trans        &trans        &trans        &trans          &kp F4  &kp F5  &kp F6  &trans   &trans
&trans          &trans        &trans        &trans        &trans        &trans        &trans          &trans  &trans  &kp F1  &kp F2   &kp F3   &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans        &kp KP_NUMLOCK  &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
